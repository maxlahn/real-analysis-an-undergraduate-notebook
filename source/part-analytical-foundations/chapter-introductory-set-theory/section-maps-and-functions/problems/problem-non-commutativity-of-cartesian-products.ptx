<?xml version="1.0" encoding="UTF-8"?>

<exercise xml:id="problem-non-commutativity-of-cartesian-products" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Non-commutativity of Cartesian products
  </title>
  
  <statement>
    <p>
      Give examples of sets <m> X </m> and <m> Y </m> so that <m> X \times Y \neq Y \times X </m>.
    </p>
  </statement>
  
  <solution>
    <p>
      If <m> X = \set{ 0 } </m> and <m> Y = \set{ 1 } </m>, then
      
      <md>
        <mrow>
          X \times Y \amp = \set{ 0 } \times \set{ 1 } = \set{ \of{ 0 , 1 } }
        </mrow>
        
        <mrow>
          \amp \neq \set{ \of{ 1 , 0 } } = \set{ 1 } \times \set{ 0 } = Y \times X
        </mrow>
      </md>.
    </p>
  </solution>
</exercise>
