<?xml version="1.0" encoding="UTF-8"?>

<exercise xml:id="exercise-from-subbase-to-topology" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    From subbase to topology
  </title>
  
  <statement>
    <p>
      Let <m> X = \set{ a , b , c , d } </m>, and consider the collection <m> \mathcal{ S } \subseteq \ps \of{ X } </m> be the collection of subsets of <m> X </m> defined by
      
      <md>
        \mathcal{ S } = \set{ \set{ a , b } , \set{ b , c } , \set{ c , d } }
      </md>.
      
      Compute explicitly the topology <m> \tau = \gen{ \mathcal{ S } } </m> on <m> X </m> generated by <m> \mathcal{ S } </m>.
    </p>
  </statement>
  
  <answer>
    <p>
      The topology <m> \tau = \gen{ \mathcal{ S } } </m> on <m> X </m> generated by <m> \mathcal{ S } </m> is
      
      <md>
        \tau = \set{ \emptyset , \set{ b } , \set{ c } , \set{ a , b } , \set{ b , c } , \set{ c , d } , \set{ a , b , c } , \set{ b , c , d } , \set{ a , b , c , d } }
      </md>.
    </p>
  </answer>
</exercise>
