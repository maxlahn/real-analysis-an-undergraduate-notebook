<exercise xml:id="problem-reciprocals-of-infinite-limits" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Reciprocals of infinite limits
  </title>
  
  <statement>
    <p>
      Prove that a sequence <m> \of{ x_{ n } }_{ n = 0 }^{ \infty } </m> of negative real numbers <m> x_{ n } \lt 0 </m> diverges to <m> -\infty </m> if and only if
      
      <md>
        \lim_{ n \to \infty }{ \frac{ 1 }{ x_{ n } } } = 0
      </md>.
    </p>
  </statement>
  
