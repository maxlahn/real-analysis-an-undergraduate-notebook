<?xml version="1.0" encoding="UTF-8"?>

<exercise xml:id="exercise-limits-and-strict-comparison" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Limits and strict comparison
  </title>
  
  <statement>
    <p>
      Give examples of convergent sequences <m> \of{ x_{ n } }_{ n = 0 }^{ \infty } </m> and <m> \of{ y_{ n } }_{ n = 0 }^{ \infty } </m> of real numbers <m> x_{ n } , y_{ n } \in \R </m> so that <m> x_{ n } \lt y_{ n } </m> for all indices <m> n \in \N </m> but
      
      <md>
        \lim_{ n \to \infty }{ x_{ n } } = \lim_{ n \to \infty }{ y_{ n } }
      </md>.
    </p>
  </statement>
  
  <solution>
    <p>
      For each natural number <m> n \in \N </m>, let <m> x_{ n } = -2^{ -n } </m> and <m> y_{ n } = 2^{ -n } </m>. Then <m> x_{ n } \lt y_{ n } </m> for all indices <m> n \in \N </m>, but
      
      <md>
        \lim_{ n \to \infty }{ x_{ n } } = 0 = \lim_{ n \to \infty }{ y_{ n } }
      </md>.
    </p>
  </solution>
</exercise>
