<?xml version="1.0" encoding="UTF-8"?>

<exercisegroup xml:id="exercise-limits-and-arithmetic" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Limits and arithmetic
  </title>
  
  <introduction>
    <p>
      Compute the limits of the given sequences of real numbers.
    </p>
  </introduction>
  
  <exercise>
    <statement>
      <p>
        Compute <m> \lim_{ n \to \infty }{ \frac{ 1 }{ n } + \frac{ 1 }{ n^{ 2 } } + \frac{ 1 }{ n^{ 3 } } } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> \lim_{ n \to \infty }{ \frac{ 1 }{ n } + \frac{ 1 }{ n^{ 2 } } + \frac{ 1 }{ n^{ 3 } } } = 0 </m>.
      </p>
    </answer>
    
    <solution>
      <p>
        We compute
        
        <md>
          <mrow>
            \lim_{ n \to \infty }{ \frac{ 1 }{ n } + \frac{ 1 }{ n^{ 2 } } + \frac{ 1 }{ n^{ 3 } } } \amp = \lim_{ n \to \infty }{ \frac{ 1 }{ n } } + \lim_{ n \to \infty }{ \frac{ 1 }{ n^{ 2 } } } + \lim_{ n \to \infty }{ \frac{ 1 }{ n^{ 3 } } }
          </mrow>
          
          <mrow>
            \amp = 0 + 0 + 0 = 0
          </mrow>
        </md>.
      </p>
    </solution>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Compute <m> \lim_{ n \to \infty }{ \frac{ 2 n + 1 }{ 3 n } } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> \lim_{ n \to \infty }{ \frac{ 2 n + 1 }{ 3 n } } = \frac{ 2 }{ 3 } </m>.
      </p>
    </answer>
    
    <solution>
      <p>
        We compute
        
        <md>
          <mrow>
            \lim_{ n \to \infty }{ \frac{ 2 n + 1 }{ 3 n } } = \lim_{ n \to \infty }{ \frac{ 2 n }{ 3 n } } + \lim_{ n \to \infty }{ \frac{ 1 }{ 3 n } }
          </mrow>
          
          <mrow>
            \amp = \lim_{ n \to \infty }{ \frac{ 2 }{ 3 } } + \frac{ 1 }{ 3 } \lim_{ n \to \infty }{ \frac{ 1 }{ n } }
          </mrow>
          
          <mrow>
            \amp = \frac{ 2 }{ 3 } + 0 = \frac{ 2 }{ 3 }
          </mrow>
        </md>.
      </p>
    </solution>
  </exercise>
</exercisegroup>
