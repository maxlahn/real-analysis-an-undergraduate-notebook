<?xml version="1.0" encoding="UTF-8"?>

<exercisegroup xml:id="exercise-the-uniform-metric" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    The uniform metric
  </title>
  
  <introduction>
    <p>
      Compute the distance between the given bounded maps in the uniform metric.
    </p>
  </introduction>
  
  <exercise>
    <statement>
      <p>
        Let <m> f , g \colon \R \to \R </m> be the constant real-valued functions defined by the formulae <m> f \of{ x } = 2 </m> and <m> g \of{ x } = \pi </m>. Compute the uniform distance <m> d_{ \infty } \of{ f , g } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> d_{ \infty } \of{ f , g } = \pi - 2 </m>.
      </p>
    </answer>
    
    <solution>
      <p>
        We compute
        
        <md>
          <mrow>
            d_{ \infty } \of{ f , g } \amp = \sup_{ x \in \R }{ d \of{ f \of{ x } , g \of{ x } } } = \sup_{ x \in \R }{ \abs{ 2 - \pi } }
          </mrow>
          
          <mrow>
            \amp = \sup_{ x \in \R }{ \of{ \pi - 2 } } = \pi - 2
          </mrow>
        </md>.
      </p>
    </solution>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Let <m> f , g \colon \clint{ -1 }{ 1 } \to \R </m> be the real-valued functions defined by the formulae <m> f \of{ x } = 2 </m> and <m> g \of{ x } = x^{ 2 } </m>. Compute the uniform distance <m> d_{ \infty } \of{ f , g } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> d_{ \infty } \of{ f , g } = 2 </m>.
      </p>
    </answer>
    
    <solution>
      <p>
        We compute
        
        <md>
          <mrow>
            d_{ \infty } \of{ f , g } \amp = \sup_{ -1 \leq x \leq 1 }{ d \of{ f \of{ x } , g \of{ x } } } = \sup_{ -1 \leq x \leq 1 }{ \abs{ 2 - x^{ 2 } } }
          </mrow>
          
          <mrow>
            \amp = \sup_{ -1 \leq x \leq 1 }{ 2 - x^{ 2 } } = 2 - 0 = 2
          </mrow>
        </md>.
      </p>
    </solution>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Let <m> f , g \colon \opint{ 0 }{ 2 } \to \R </m> be the real-valued functions defined by the formulae <m> f \of{ x } = 2 - x </m> and <m> g \of{ x } = 1 + 3 x </m>. Compute the uniform distance <m> d_{ \infty } \of{ f , g } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> d_{ \infty } \of{ f , g } = 2 </m>.
      </p>
    </answer>
    
    <solution>
      <p>
        We compute
        
        <md>
          <mrow>
            d_{ \infty } \of{ f , g } \amp = \sup_{ 0 \lt x \lt 2 }{ d \of{ f \of{ x } , g \of{ x } } } = \sup_{ 0 \lt x \lt 2 }{ \abs{ 2 - x - \of{ 1 + 3 x } } }
          </mrow>
          
          <mrow>
            \amp = \sup_{ 0 \lt x \lt 2 }{ \abs{ 1 - 4 x } } = 7
          </mrow>
        </md>.
      </p>
    </solution>
  </exercise>
</exercisegroup>
