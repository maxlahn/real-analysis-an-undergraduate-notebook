<?xml version="1.0" encoding="UTF-8"?>

<exercisegroup xml:id="exercise-computing-distances-in-metric-spaces" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Computing distances in metric spaces
  </title>
  
  <introduction>
    <p>
      Compute the distance between the given points in the indicated metric space.
    </p>
  </introduction>
  
  <exercise>
    <introduction>
      <p>
        Let <m> d </m> be the Euclidean metric on the real coordinate plane <m> \R^{ 2 } </m>.
      </p>
    </introduction>
    
    <task>
      <statement>
        <p>
          Compute <m> d \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 2 } </m> and <m> \vect{ y } = \of{ -1 , 4 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> d \of{ \vect{ x } , \vect{ y } } = \sqrt{ 20 } </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          We compute
          
          <md>
            <mrow>
              d \of{ \vect{ x } , \vect{ y } } \amp = \sqrt{ \of{ 3 - \of{ -1 } }^{ 2 } + \of{ 2 - 4 }^{ 2 } } = \sqrt{ 4^{ 2 } + \of{ -2 }^{ 2 } }
            </mrow>
            
            <mrow>
              \amp = \sqrt{ 16 + 4 } = \sqrt{ 20 }
            </mrow>
          </md>.
        </p>
      </solution>
    </task>
    
    <task>
      <statement>
        <p>
          Compute <m> d \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 4 } </m> and <m> \vect{ y } = \of{ 0 , 0 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> d \of{ \vect{ x } , \vect{ y } } = 5 </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          We compute
          
          <md>
            <mrow>
              d \of{ \vect{ x } , \vect{ y } } \amp = \sqrt{ \of{ 3 - 0 }^{ 2 } + \of{ 4 - 0 }^{ 2 } } = \sqrt{ 3^{ 2 } + 4^{ 2 } }
            </mrow>
            
            <mrow>
              \amp = \sqrt{ 9 + 16 } = \sqrt{ 25 } = 5
            </mrow>
          </md>.
        </p>
      </solution>
    </task>
  </exercise>
  
  <exercise>
    <introduction>
      <p>
        Let <m> d_{ 3 } </m> be the <m> 3 </m>-metric on the real coordinate plane <m> \R^{ 2 } </m>.
      </p>
    </introduction>
    
    <task>
      <statement>
        <p>
          Compute <m> d_{ 3 } \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 2 } </m> and <m> \vect{ y } = \of{ -1 , 4 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> d_{ 3 } \of{ \vect{ x } , \vect{ y } } = \sqrt[ 3 ]{ 72 } </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          We compute
          
          <md>
            <mrow>
              d_{ 3 } \of{ \vect{ x } , \vect{ y } } \amp = \sqrt[ 3 ]{ \abs{ 3 - \of{ -1 } }^{ 3 } + \abs{ 2 - 4 }^{ 3 } } = \sqrt[ 3 ]{ 4^{ 3 } + 2^{ 3 } }
            </mrow>
            
            <mrow>
              \amp = \sqrt[ 3 ]{ 64 + 8 } = \sqrt[ 3 ]{ 72 }
            </mrow>
          </md>.
        </p>
      </solution>
    </task>
  </exercise>
  
  <exercise>
    <introduction>
      <p>
        Let <m> d_{ \infty } </m> be the <m> \infty </m>-metric on the real coordinate plane <m> \R^{ 2 } </m>.
      </p>
    </introduction>
    
    <task>
      <statement>
        <p>
          Compute <m> d_{ \infty } \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 2 } </m> and <m> \vect{ y } = \of{ -1 , 4 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> d_{ \infty } \of{ \vect{ x } , \vect{ y } } = 4 </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          We compute
          
          <md>
            <mrow>
              d_{ \infty } \of{ \vect{ x } , \vect{ y } } \amp = \max \of{ \set{ \abs{ 3 - \of{ -1 } } , \abs{ 2 - 4 } } }
            </mrow>
            
            <mrow>
              \amp = \max \of{ \set{ \abs{ 4 } , \abs{ -2 } } } = \max \of{ \set{ 4 , 2 } } = 4
            </mrow>
          </md>.
        </p>
      </solution>
    </task>
    
    <task>
      <statement>
        <p>
          Compute <m> d_{ \infty } \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 4 } </m> and <m> \vect{ y } = \of{ 0 , 0 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> d_{ 3 } \of{ \vect{ x } , \vect{ y } } = 4 </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          We compute
          
          <md>
            <mrow>
              d_{ \infty } \of{ \vect{ x } , \vect{ y } } \amp = \max \of{ \set{ \abs{ 3 - 0 } , \abs{ 4 - 0 } } } = \max \of{ \set{ \abs{ 3 } , \abs{ 4 } } }
            </mrow>
            
            <mrow>
              \amp = max \of{ \set{ 3 , 4 } } = 4
            </mrow>
          </md>.
        </p>
      </solution>
    </task>
  </exercise>
  
  <exercise>
    <introduction>
      <p>
        Let <m> \delta_{ \R^{ 2 } } </m> be the discrete metric on the real coordinate plane <m> \R^{ 2 } </m>.
      </p>
    </introduction>
    
    <task>
      <statement>
        <p>
          Compute <m> \delta_{ \R^{ 2 } } \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 2 } </m> and <m> \vect{ y } = \of{ -1 , 4 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> \delta_{ \R^{ 2 } } \of{ \vect{ x } , \vect{ y } } = 1 </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          Since <m> \vect{ x } \neq \vect{ y } </m>, <m> \delta_{ \R^{ 2 } } \of{ \vect{ x } , \vect{ y } } = 1 </m>.
        </p>
      </solution>
    </task>
    
    <task>
      <statement>
        <p>
          Compute <m> \delta_{ \R^{ 2 } } \of{ \vect{ x } , \vect{ y } } </m>, where <m> \vect{ x } = \of{ 3 , 4 } </m> and <m> \vect{ y } = \of{ 0 , 0 } </m>.
        </p>
      </statement>
      
      <answer>
        <p>
          <m> \delta_{ \R^{ 2 } } \of{ \vect{ x } , \vect{ y } } = 1 </m>.
        </p>
      </answer>
      
      <solution>
        <p>
          Since <m> \vect{ x } \neq \vect{ y } </m>, <m> \delta_{ \R^{ 2 } } \of{ \vect{ x } , \vect{ y } } = 1 </m>.
        </p>
      </solution>
    </task>
  </exercise>
</exercisegroup>
