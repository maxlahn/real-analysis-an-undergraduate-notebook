<?xml version="1.0" encoding="UTF-8"?>

<exercisegroup xml:id="exercise-computing-upper-lower-limits" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Computing upper/lower limits
  </title>
  
  <introduction>
    <p>
      Compute the upper and lower limits of the given sequences of real numbers.
    </p>
  </introduction>
  
  <exercise>
    <statement>
      <p>
        Compute <m> \limsup_{ n \to \infty }{ 2^{ n } } </m> and <m> \liminf_{ n \to \infty }{ 2^{ n } } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> \limsup_{ n \to \infty }{ 2^{ n } } = \liminf_{ n \to \infty }{ 2^{ n } } = \infty </m>.
      </p>
    </answer>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Compute <m> \limsup_{ n \to \infty }{ 2^{ -n } } </m> and <m> \liminf_{ n \to \infty }{ 2^{ -n } } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> \limsup_{ n \to \infty }{ 2^{ -n } } = \liminf_{ n \to \infty }{ 2^{ -n } } = 0 </m>.
      </p>
    </answer>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Compute <m> \limsup_{ n \to \infty }{ \of{ -2 }^{ n } } </m> and <m> \liminf_{ n \to \infty }{ \of{ -2 }^{ n } } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> \limsup_{ n \to \infty }{ \of{ -2 }^{ n } } = \infty </m> and <m> \liminf_{ n \to \infty }{ \of{ -2 }^{ n } } = -\infty </m>.
      </p>
    </answer>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Compute <m> \limsup_{ n \to \infty }{ \of{ -2 }^{ -n } } </m> and <m> \liminf_{ n \to \infty }{ \of{ -2 }^{ -n } } </m>.
      </p>
    </statement>
    
    <answer>
      <p>
        <m> \limsup_{ n \to \infty }{ \of{ -2 }^{ n } } = \liminf_{ n \to \infty }{ \of{ -2 }^{ n } } = 0 </m>.
      </p>
    </answer>
  </exercise>
</exercisegroup>
