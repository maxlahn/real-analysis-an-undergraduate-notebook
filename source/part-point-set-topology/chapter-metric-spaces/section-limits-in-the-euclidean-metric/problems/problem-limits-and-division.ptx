<exercise xml:id="problem-limits-and-division" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Limits and division
  </title>
  
  <statement>
    <p>
      Prove that
      
      <md>
        \lim_{ n \to \infty }{ \frac{ 1 }{ x_{ n } } } = \frac{ 1 }{ \lim_{ n \to \infty }{ x_{ n } } }
      </md>
      
      for every sequence <m> \of{ x_{ n } }_{ n = 0 }^{ \infty } </m> of non-zero real numbers <m> x_{ n } \in \R \setminus \set{ 0 } </m> which converges to a non-zero real number limit
      
      <md>
        \lim_{ n \to \infty }{ x_{ n } } \neq 0
      </md>.
    </p>
  </statement>
  
