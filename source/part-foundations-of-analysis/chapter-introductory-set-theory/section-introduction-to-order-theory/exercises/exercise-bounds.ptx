<?xml version="1.0" encoding="UTF-8"?>

<exercisegroup xml:id="exercise-bounds" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>
    Bounds
  </title>
  
  <introduction>
    <p>
      Determine whether or not the following subsets of the partially ordered set <m> \ps \of{ \N } </m> are bounds for the given element.
    </p>
  </introduction>
  
  <exercise>
    <statement>
      <p>
        Which of the following are upper bounds for the set <m> \set{ 1 , 2 , 3 } </m> in the partially ordered set <m> \ps \of{ \N } </m>?
      </p>
    </statement>
    
    <choices multiple-correct="yes">
      <choice correct="no">
        <statement>
          <p>
            <m> \emptyset </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="no">
        <statement>
          <p>
            <m> \set{ 1 , 2 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="yes">
        <statement>
          <p>
            <m> \set{ 1 , 2 , 3 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="no">
        <statement>
          <p>
            <m> \N \setminus \set{ 1 , 2 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="yes">
        <statement>
          <p>
            <m> \N \setminus \set{ 0 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="yes">
        <statement>
          <p>
            <m> \N </m>
          </p>
        </statement>
      </choice>
    </choices>
  </exercise>
  
  <exercise>
    <statement>
      <p>
        Which of the following are lower bounds for the set <m> \set{ 1 , 2 , 3 } </m> in the partially ordered set <m> \ps \of{ \N } </m>?
      </p>
    </statement>
    
    <choices multiple-correct="yes">
      <choice correct="yes">
        <statement>
          <p>
            <m> \emptyset </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="yes">
        <statement>
          <p>
            <m> \set{ 1 , 2 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="yes">
        <statement>
          <p>
            <m> \set{ 1 , 2 , 3 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="no">
        <statement>
          <p>
            <m> \N \setminus \set{ 1 , 2 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="no">
        <statement>
          <p>
            <m> \N \setminus \set{ 0 } </m>
          </p>
        </statement>
      </choice>
      
      <choice correct="no">
        <statement>
          <p>
            <m> \N </m>
          </p>
        </statement>
      </choice>
    </choices>
  </exercise>
</exercisegroup>
